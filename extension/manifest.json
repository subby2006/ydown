{
  "manifest_version": 3,
  "name": "YouTube Local Browser Downloader",
  "version": "0.5.3",
  "description": "Downloads YouTube adaptive streams and muxes them locally inside the browser.",
  "minimum_chrome_version": "120",
  "permissions": [
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://o4512046378254336.ingest.us.sentry.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "notification-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
