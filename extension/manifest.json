{
  "manifest_version": 3,
  "name": "YouTube Local Browser Downloader",
  "version": "0.5.1",
  "description": "Downloads YouTube adaptive streams and muxes them locally inside the browser.",
  "minimum_chrome_version": "120",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
